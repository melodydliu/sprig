# Sprig environment variables.
#
# Copy the ones you need into `.env.local` (git-ignored). A plain `.env` is NOT
# ignored — always use `.env.local`. Restart `npm start` after any change here.

# ── Supabase (Milestone 5b+) ────────────────────────────────────────────────
# Dashboard ▸ Project Settings ▸ API (labelled "Data API" on newer projects):
#   EXPO_PUBLIC_SUPABASE_URL       → "Project URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY  → "anon" / "public" key
# Apply supabase/schema.sql then supabase/policies.sql in the SQL editor first.
# Full walkthrough: supabase/README.md
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Dev conveniences ───────────────────────────────────────────────────────
# Skip the sign-in wall while iterating (mock auth only). Never commit this.
# EXPO_PUBLIC_SPRIG_DEV_AUTOLOGIN=1

# Android only: Google Maps SDK key (Android milestone). Not used on iOS (Apple Maps).
# GOOGLE_MAPS_ANDROID_API_KEY=
