{
  "expo": {
    "name": "Sprig",
    "slug": "sprig",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sprig",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sprigbook.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sprig uses the camera so you can photograph a plant the moment you spot it.",
        "NSPhotoLibraryUsageDescription": "Sprig lets you add photos from your library to a find.",
        "NSPhotoLibraryAddUsageDescription": "Sprig can save a find's photo back to your library when you export it.",
        "NSLocationWhenInUseUsageDescription": "Sprig tags each find with where you saw it so you can come back later. Location is saved to your private journal and its cloud backup.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sprigbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#181611",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sprig uses the camera so you can photograph a plant the moment you spot it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sprig lets you add photos from your library to a find."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sprig tags each find with where you saw it so you can come back later. Location is saved to your private journal and its cloud backup."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21989f4d-a3b5-4855-b795-bb2cbd528ff2"
      }
    },
    "owner": "melodydliu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21989f4d-a3b5-4855-b795-bb2cbd528ff2"
    }
  }
}
